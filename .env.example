# Optional overrides. The supplied public project is already configured in src/lib/public-config.ts.
# Set both values together only when changing projects. Never use secret/service_role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional canonical guest URL for sharing metadata and local-preview QR links.
# Keep empty for the existing GitHub Pages site. On another host, set its verified HTTPS URL.
# Cloudflare Pages example after the project name has been allocated:
# VITE_PUBLIC_SITE_URL=https://your-project.pages.dev/
VITE_PUBLIC_SITE_URL=

# Developer-managed public service identifiers. Never put client secrets here.
# Editor users only change invitation content; service setup stays in deployment.
VITE_NAVER_MAP_CLIENT_ID=
VITE_KAKAO_JAVASCRIPT_KEY=

# Optional local build path. CI selects /ju_wedding/ automatically.
# BASE_PATH=/ju_wedding/

# For an explicitly browser-local development demo (not shared storage):
# VITE_LOCAL_PREVIEW=true
